{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Must match the Worker name used by Workers Builds. Never point this config at another site's resources.
  "name": "540daily-site",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "540daily.com", "custom_domain": true }],
  "vars": { "PUBLIC_BASE_URL": "https://540daily.com" },
  // Secrets (set with `npx wrangler secret put <NAME> --name 540daily-site`, owner approval required):
  //   OWNER_EMAIL, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  // Local development reads them from hosting/cloudflare/.dev.vars.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "540daily-site-db",
      "database_id": "d2c17dad-536d-4d85-9be4-f48f7fb2d6f1",
      "migrations_dir": "../../db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "540daily-site-media" }]
}
