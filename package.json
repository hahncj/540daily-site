{
  "name": "540daily-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "540 Daily: public news and research dashboard on one Cloudflare Worker.",
  "engines": {
    "node": "^26.13.0",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:node": "BUILD_TARGET=node react-router build",
    "start:node": "node hosting/node/server.js",
    "typegen": "wrangler types hosting/cloudflare/worker-configuration.d.ts -c hosting/cloudflare/wrangler.jsonc --env-file=hosting/cloudflare/.dev.vars.example && react-router typegen",
    "typecheck": "npm run typegen && tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply 540daily-site-db --local --persist-to .wrangler/state -c hosting/cloudflare/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply 540daily-site-db --remote -c hosting/cloudflare/wrangler.jsonc",
    "auth:schema": "auth generate --config scripts/auth-cli-config.ts --output server/db/auth-schema.ts --yes",
    "deploy": "npm run build && wrangler deploy",
    "deploy:ci": "wrangler d1 migrations apply 540daily-site-db --remote -c hosting/cloudflare/wrangler.jsonc && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.18",
    "@better-auth/core": "1.7.18",
    "@better-auth/mcp": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "xss": "1.0.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@playwright/test": "1.65.0",
    "@react-router/dev": "8.5.1",
    "@remix-run/node-fetch-server": "1.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.18",
    "better-call": "1.4.5",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.156.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
